{
  "name": "camel-dashboard-console",
  "version": "1.0.0",
  "description": "Camel Dashboard Console",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/camel-tooling/camel-dashboard-console.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "lint": "yarn eslint src tests --fix && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test:e2e": "yarn playwright test --config tests/config/playwright.config.ts",
    "test:e2e-dev": "DEV=true yarn playwright test --config tests/config/playwright.config.ts",
    "test:e2e-headed": "yarn playwright test --config tests/config/playwright.config.ts --headed",
    "test:e2e-ui": "yarn playwright test --config tests/config/playwright.config.ts --ui",
    "test:e2e-report": "yarn playwright show-report tests/reports/html",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@patternfly/react-component-groups": "^6.2.1",
    "@patternfly/react-core": "^6.3.1",
    "@patternfly/react-data-view": "^6.5.0",
    "@patternfly/react-icons": "^6.3.1",
    "@patternfly/react-styles": "^6.2.2",
    "@patternfly/react-table": "^6.2.2",
    "@playwright/test": "^1.63.0",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^20.14.9",
    "@types/react": "^18.0.0",
    "@types/react-helmet": "^6.1.4",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^6.7.1",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.1",
    "i18next": "^25.8.18",
    "i18next-parser": "^3.11.0",
    "jsonpath": "^1.1.1",
    "lodash": "^4.17.23",
    "mini-svg-data-uri": "^1.4.4",
    "pluralize": "^8.0.0",
    "prettier": "^2.7.1",
    "prettier-stylelint": "^0.4.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet": "^6.1.0",
    "react-i18next": "~16.5.8",
    "react-router": "~7.13.1",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^3.3.1",
    "stylelint": "^15.3.0",
    "stylelint-config-standard": "^31.0.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.8.1",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "typescript": "~5.9.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "consolePlugin": {
    "name": "camel-dashboard-console",
    "version": "1.0.0",
    "displayName": "Camel Dashboard Console",
    "description": "Camel Dashboard - OCP Console Plugin.",
    "exposedModules": {
      "CamelAppList": "./components/camel-list-page/CamelAppList",
      "CamelApp": "./components/camel-app-page/CamelApp"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "peerDependencies": {
    "@babel/core": "^7.0.1",
    "@babel/preset-env": "^7.0.0",
    "babel-loader": "^8.0.2",
    "i18next": "^25.8.18",
    "mocha": "^10.5.1"
  }
}
